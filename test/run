#!/bin/sh
# test/run - every now-playing shell test (test/*.t). Skips are counted.
set -eu
_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
_rc=0; _pass=0; _skip=0
for _t in "$_dir"/*.t; do
  [ -f "$_t" ] || continue
  _out=$(sh "$_t" 2>&1) || _rc=1
  printf '%s\n' "$_out"
  case "$(printf '%s\n' "$_out" | tail -n 1)" in
    skip\ *) _skip=$((_skip + 1)) ;; ok\ *) _pass=$((_pass + 1)) ;;
  esac
done
[ "$_rc" -eq 0 ] || { echo "now-playing tests FAILED"; exit 1; }
if [ "$_skip" -gt 0 ]; then
  printf 'all now-playing tests passed (%d ok, %d skipped)\n' "$_pass" "$_skip"
else printf 'all now-playing tests passed (%d)\n' "$_pass"; fi

# now-playing.reqs - venv for the now-playing daemon's Chromecast FALLBACK.
# pychromecast pulls zeroconf / casttube / ifaddr / protobuf transitively. Only
# used when local MPRIS is idle (i.e. while casting); local playback needs none
# of it. Read-only receiver status gates the media controller so a device is
# never driven unless a real Cast media receiver is already running.
# playerctl is a SYSTEM binary (packages/), not a venv dep.
pychromecast==14.0.10

# numpy: the daemon-side audio analyser (libexec/npspectrum_lib.py). The DSP
# moved out of the waybar card so a view stops acquiring signal, and the FFT
# needs
# this. Deliberately NOT a pure-python FFT: at 4096 points every ~46 ms a
# python loop would cost more CPU than the whole daemon does today.
numpy>=1.24

# jeepney: the MPRIS reader (libexec/npmpris_lib.py). Pure python, no compiled
# extension. It replaces a `playerctl position` PROCESS SPAWN every POLL_SECS
# (57,600 a day) with a method call on a held-open bus connection, and it is the
# only way to read CanPause / CanGoNext / CanGoPrevious / CanSeek, which are
# player-interface properties that playerctl 2.4.1's --format cannot reach.
jeepney>=0.8
